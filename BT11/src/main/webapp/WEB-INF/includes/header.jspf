<%@ page pageEncoding="UTF-8" %>
<%@ taglib prefix="c" uri="jakarta.tags.core" %>
<%-- Header dung chung: menu Trang Chu, San pham, Dang nhap, Trang quan tri (chi admin), Gio hang, Don hang --%>
<c:set var="ctx" value="${pageContext.request.contextPath}"/>
<nav class="navbar navbar-expand-lg ${empty navClass ? 'navbar-dark bg-primary' : navClass}">
    <div class="container">
        <a class="navbar-brand fw-bold" href="${ctx}/home"><i class="bi bi-book-half"></i> BookStore</a>
        <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#mainMenu">
            <span class="navbar-toggler-icon"></span>
        </button>
        <div class="collapse navbar-collapse" id="mainMenu">
            <ul class="navbar-nav me-auto">
                <li class="nav-item"><a class="nav-link" href="${ctx}/home">Trang Chủ</a></li>
                <li class="nav-item"><a class="nav-link" href="${ctx}/books">Sản phẩm</a></li>
                <c:if test="${sessionScope.account.adminRole}">
                    <li class="nav-item"><a class="nav-link" href="${ctx}/admin/home">Trang quản trị</a></li>
                </c:if>
            </ul>
            <ul class="navbar-nav">
                <c:choose>
                    <c:when test="${not empty sessionScope.account}">
                        <li class="nav-item">
                            <a class="nav-link" href="${ctx}/orders"><i class="bi bi-receipt"></i> Đơn hàng</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link" href="${ctx}/cart">
                                <i class="bi bi-cart3"></i> Giỏ hàng
                                <c:if test="${sessionScope.cartCount > 0}">
                                    <span class="badge rounded-pill text-bg-danger">${sessionScope.cartCount}</span>
                                </c:if>
                            </a>
                        </li>
                        <li class="nav-item">
                            <span class="nav-link">
                                <i class="bi bi-person-circle"></i> <c:out value="${sessionScope.account.fullname}"/>
                                (${sessionScope.account.adminRole ? 'Admin' : 'User'})
                            </span>
                        </li>
                        <li class="nav-item"><a class="nav-link" href="${ctx}/logout">Đăng xuất</a></li>
                    </c:when>
                    <c:otherwise>
                        <li class="nav-item"><a class="nav-link" href="${ctx}/login">Đăng nhập</a></li>
                        <li class="nav-item"><a class="nav-link" href="${ctx}/register">Đăng ký</a></li>
                    </c:otherwise>
                </c:choose>
            </ul>
        </div>
    </div>
</nav>
